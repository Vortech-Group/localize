{
    "name": "vortech/laravel-localize",
    "description": "Typed, per-model translation tables for Eloquent: a locale view with exact fallback rules, transactional bulk saves and a unique validation rule.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "eloquent",
        "localization",
        "translations",
        "i18n",
        "multilingual"
    ],
    "homepage": "https://github.com/Vortech-Group/localize",
    "authors": [
        {
            "name": "Mate Papp",
            "email": "mate@vortech.hu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "laravel/prompts": "^0.3"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vortech\\Localize\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vortech\\Localize\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vortech\\Localize\\LocalizeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "refactor": "rector",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "check": [
            "@test:lint",
            "@test:refactor",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
